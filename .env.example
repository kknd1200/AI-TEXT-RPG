# ─────────────────────────────────────────────────────────────
# 데이터 소스 (둘 중 하나만 있어도 됩니다)
# ─────────────────────────────────────────────────────────────

# 키움증권 REST API
# 발급: https://openapi.kiwoom.com  ->  로그인 > 앱 등록 (앱키 / 시크릿키)
# 구버전 OpenAPI+ (OCX/COM) 가 아니라 REST API 키입니다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
# real = 실전, mock = 모의투자
KIWOOM_ENV=real
# 거래소 구분 1=KRX 2=NXT 3=통합 / 조회일자 구분 0=미포함 1=포함
# 어떤 값이 맞는지는 `krflow probe` 가 찾아줍니다.
KIWOOM_STEX_TP=1
KIWOOM_QRY_DT_TP=1

# 한국투자증권 KIS Open API
# 발급: https://apiportal.koreainvestment.com  ->  My Page > 앱 등록
KIS_APP_KEY=
KIS_APP_SECRET=
# real = 실전투자 도메인, vts = 모의투자 도메인
KIS_ENV=real

# ─────────────────────────────────────────────────────────────
# 텔레그램 봇 (krflow bot 을 쓸 때만)
# ─────────────────────────────────────────────────────────────

# @BotFather 에게 /newbot 을 보내 받은 토큰
TELEGRAM_BOT_TOKEN=

# 이 봇을 쓸 수 있는 chat_id 목록 (쉼표 구분).
# 비워두면 아무도 못 씁니다. 봇에 아무 메시지나 보내면 본인 chat_id 를 알려줍니다.
# 그룹방은 음수 id 입니다. 예: TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=

# ─────────────────────────────────────────────────────────────
# 기타
# ─────────────────────────────────────────────────────────────

# HTTP 요청 타임아웃(초)
KRFLOW_TIMEOUT=10

# 토큰·구독 상태 저장 위치 (기본: ~/.krflow)
# KRFLOW_HOME=
